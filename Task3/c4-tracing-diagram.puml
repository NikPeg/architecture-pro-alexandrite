@startuml C4-Container Diagram: Система Александрит с трейсингом
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram: Система Александрит с трейсингом

Person(customer, "Клиент", "Покупатель ювелирных изделий")
Person(seller, "Продавец", "Менеджер по продажам")
Person(apiUser, "API User", "Внешний продавец")
Person(operator, "Оператор", "Производитель изделий")
Person(devops, "DevOps/Разработчик", "Анализ трейсов")

System_Boundary(shop, "Онлайн-магазин") {
    Container(shopUI, "Internet Shop", "Vue, TypeScript, Three.js", "Веб-приложение для клиентов")
    Container(shopAPI, "Shop API", "Java Spring Boot", "API для онлайн-магазина")
    ContainerDb(shopDB, "Shop DB", "PostgreSQL", "База данных заказов и клиентов")
}

System_Boundary(crm, "CRM") {
    Container(crmUI, "CRM", "Vue, TypeScript", "Веб-приложение для продавцов")
    Container(crmAPI, "CRM API", "Java Spring Boot", "API для CRM")
}

System_Boundary(mes, "MES") {
    Container(mesUI, "MES", "React, TypeScript", "Веб-приложение для операторов")
    Container(mesAPI, "MES API", "C#", "API для MES")
    ContainerDb(mesDB, "MES DB", "PostgreSQL", "База данных производства")
}

System_Boundary(storage, "Хранилище") {
    Container(s3Storage, "3D Files Storage", "S3", "Хранилище 3D-файлов")
}

System_Boundary(messaging, "Очереди") {
    Container(rabbitMQ, "Messages Queue", "RabbitMQ", "Очередь сообщений")
}

System_Boundary(tracing, "Трейсинг") {
    Container(otelCollector, "OpenTelemetry Collector", "OTLP", "Сбор и обработка трейсов", $tags="tracing+new")
    Container(jaegerBackend, "Jaeger Backend", "Jaeger", "Хранение и индексация трейсов", $tags="tracing+new")
    Container(jaegerUI, "Jaeger UI", "Jaeger", "Визуализация трейсов", $tags="tracing+new")
}

' Определение стиля для тега "new" (новые компоненты трейсинга)
AddContainerTag("new", "#FF6B6B", "#FFFFFF", "#CC0000")

' Взаимодействия пользователей
Rel(customer, shopUI, "Просматривает товары, создаёт заказы")
Rel(seller, crmUI, "Управляет заказами")
Rel(apiUser, mesAPI, "Запрашивает расчёт стоимости", "REST API")
Rel(operator, mesUI, "Управляет производством")
Rel(devops, jaegerUI, "Анализирует трейсы")

' Взаимодействия внутри онлайн-магазина
Rel(shopUI, shopAPI, "HTTP/REST")
Rel(shopAPI, shopDB, "Чтение/запись", "JDBC")
Rel(shopAPI, s3Storage, "Загрузка/скачивание 3D-файлов", "S3 API")

' Взаимодействия CRM
Rel(crmUI, crmAPI, "HTTP/REST")
Rel(crmAPI, shopDB, "Чтение/запись", "JDBC")
Rel(crmAPI, s3Storage, "Доступ к 3D-файлам", "S3 API")

' Взаимодействия MES
Rel(mesUI, mesAPI, "HTTP/REST")
Rel(mesAPI, mesDB, "Чтение/запись", "ADO.NET")
Rel(mesAPI, s3Storage, "Чтение 3D-файлов", "S3 API")

' Очереди сообщений
Rel(shopAPI, rabbitMQ, "Отправка сообщений о заказах", "AMQP")
Rel(rabbitMQ, crmAPI, "Уведомления о новых заказах", "AMQP")
Rel(crmAPI, rabbitMQ, "Отправка сообщений о статусах", "AMQP")
Rel(rabbitMQ, mesAPI, "Уведомления о заказах", "AMQP")
Rel(mesAPI, rabbitMQ, "Отправка сообщений о статусах", "AMQP")
Rel(rabbitMQ, crmAPI, "Уведомления о статусах", "AMQP")

' Трейсинг - новые связи
Rel(shopAPI, otelCollector, "Отправка трейсов", "OTLP gRPC")
Rel(crmAPI, otelCollector, "Отправка трейсов", "OTLP gRPC")
Rel(mesAPI, otelCollector, "Отправка трейсов", "OTLP gRPC")
Rel(otelCollector, jaegerBackend, "Экспорт трейсов", "gRPC")
Rel(jaegerUI, jaegerBackend, "Запросы трейсов", "HTTP/gRPC")

' Передача контекста через RabbitMQ
Rel(shopAPI, rabbitMQ, "Передача trace context", "AMQP Headers")
Rel(rabbitMQ, crmAPI, "Передача trace context", "AMQP Headers")
Rel(rabbitMQ, mesAPI, "Передача trace context", "AMQP Headers")


SHOW_LEGEND()

@enduml

