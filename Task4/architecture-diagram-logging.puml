@startuml C4-Container Diagram: Система Александрит с логированием
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram: Система Александрит с логированием

Person(customer, "Клиент", "Покупатель ювелирных изделий")
Person(seller, "Продавец", "Менеджер по продажам")
Person(apiUser, "API User", "Внешний продавец")
Person(operator, "Оператор", "Производитель изделий")
Person(devops, "DevOps/Разработчик", "Анализ логов")

System_Boundary(shop, "Онлайн-магазин") {
    Container(shopUI, "Internet Shop", "Vue, TypeScript, Three.js", "Веб-приложение для клиентов")
    Container(shopAPI, "Shop API", "Java Spring Boot", "API для онлайн-магазина")
    ContainerDb(shopDB, "Shop DB", "PostgreSQL", "База данных заказов и клиентов")
}

System_Boundary(crm, "CRM") {
    Container(crmUI, "CRM", "Vue, TypeScript", "Веб-приложение для продавцов")
    Container(crmAPI, "CRM API", "Java Spring Boot", "API для CRM")
}

System_Boundary(mes, "MES") {
    Container(mesUI, "MES", "React, TypeScript", "Веб-приложение для операторов")
    Container(mesAPI, "MES API", "C#", "API для MES")
    ContainerDb(mesDB, "MES DB", "PostgreSQL", "База данных производства")
}

System_Boundary(storage, "Хранилище") {
    Container(s3Storage, "3D Files Storage", "S3", "Хранилище 3D-файлов")
}

System_Boundary(messaging, "Очереди") {
    Container(rabbitMQ, "Messages Queue", "RabbitMQ", "Очередь сообщений")
}

System_Boundary(logging, "Логирование") {
    Container(filebeatShop, "Filebeat", "Filebeat", "Сбор логов Shop API/DB", $tags="logging+new")
    Container(filebeatCRM, "Filebeat", "Filebeat", "Сбор логов CRM API", $tags="logging+new")
    Container(filebeatMES, "Filebeat", "Filebeat", "Сбор логов MES API/DB", $tags="logging+new")
    Container(filebeatInfra, "Filebeat", "Filebeat", "Сбор логов RabbitMQ/S3", $tags="logging+new")
    Container(logstash, "Logstash", "Logstash", "Обработка и трансформация логов", $tags="logging+new")
    ContainerDb(elasticsearch, "Elasticsearch", "Elasticsearch", "Хранение и индексация логов", $tags="logging+new")
    Container(kibana, "Kibana", "Kibana", "Визуализация и анализ логов", $tags="logging+new")
}

' Определение стиля для тега "new" (новые компоненты логирования)
AddContainerTag("new", "#FF6B6B", "#FFFFFF", "#CC0000", $legendText="новые компоненты логирования")

' Взаимодействия пользователей
Rel(customer, shopUI, "Просматривает товары, создаёт заказы")
Rel(seller, crmUI, "Управляет заказами")
Rel(apiUser, mesAPI, "Запрашивает расчёт стоимости", "REST API")
Rel(operator, mesUI, "Управляет производством")
Rel(devops, kibana, "Анализирует логи")

' Взаимодействия внутри онлайн-магазина
Rel(shopUI, shopAPI, "HTTP/REST")
Rel(shopAPI, shopDB, "Чтение/запись", "JDBC")
Rel(shopAPI, s3Storage, "Загрузка/скачивание 3D-файлов", "S3 API")

' Взаимодействия CRM
Rel(crmUI, crmAPI, "HTTP/REST")
Rel(crmAPI, shopDB, "Чтение/запись", "JDBC")
Rel(crmAPI, s3Storage, "Доступ к 3D-файлам", "S3 API")

' Взаимодействия MES
Rel(mesUI, mesAPI, "HTTP/REST")
Rel(mesAPI, mesDB, "Чтение/запись", "ADO.NET")
Rel(mesAPI, s3Storage, "Чтение 3D-файлов", "S3 API")

' Очереди сообщений
Rel(shopAPI, rabbitMQ, "Отправка сообщений о заказах", "AMQP")
Rel(rabbitMQ, crmAPI, "Уведомления о новых заказах", "AMQP")
Rel(crmAPI, rabbitMQ, "Отправка сообщений о статусах", "AMQP")
Rel(rabbitMQ, mesAPI, "Уведомления о заказах", "AMQP")
Rel(mesAPI, rabbitMQ, "Отправка сообщений о статусах", "AMQP")
Rel(rabbitMQ, crmAPI, "Уведомления о статусах", "AMQP")

' Логирование - сбор логов в файлы (неявные связи через файловую систему)
Rel(shopAPI, filebeatShop, "Логи в файлы", "JSON Logs")
Rel(shopDB, filebeatShop, "Логи в файлы", "PostgreSQL Logs")
Rel(crmAPI, filebeatCRM, "Логи в файлы", "JSON Logs")
Rel(mesAPI, filebeatMES, "Логи в файлы", "JSON Logs")
Rel(mesDB, filebeatMES, "Логи в файлы", "PostgreSQL Logs")
Rel(rabbitMQ, filebeatInfra, "Логи в файлы", "RabbitMQ Logs")
Rel(s3Storage, filebeatInfra, "Логи доступа", "S3 Access Logs")

' Логирование - отправка в Logstash
Rel(filebeatShop, logstash, "Отправка логов", "Beats Protocol")
Rel(filebeatCRM, logstash, "Отправка логов", "Beats Protocol")
Rel(filebeatMES, logstash, "Отправка логов", "Beats Protocol")
Rel(filebeatInfra, logstash, "Отправка логов", "Beats Protocol")

' Логирование - обработка и сохранение
Rel(logstash, elasticsearch, "Индексация логов", "HTTP/REST")

' Логирование - визуализация
Rel(kibana, elasticsearch, "Запросы логов", "HTTP/REST")

SHOW_LEGEND()

@enduml

